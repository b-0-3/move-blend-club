// ═══════════════════════════════════════════════════════════════
// REGLAS DE SEGURIDAD DE FIRESTORE — Move Blend Club
// Cópialas enteras en: Firebase → Firestore Database → Reglas → Publicar
//
// Idea general:
//  · Eventos, productos, colaboradores y ajustes: los lee cualquiera,
//    solo los cambia un admin.
//  · Cada usuario ve y edita SOLO su ficha, y NO puede tocar su plan.
//    El plan (miembro/socio) solo lo cambia el servidor cuando Stripe
//    confirma el pago, o un admin a mano.
//  · Los pedidos solo los crea el servidor. Cada uno ve los suyos.
//  · Admin = que exista un documento con su ID en la colección "admins"
//    (esa colección solo se toca desde la consola de Firebase).
// ═══════════════════════════════════════════════════════════════
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() { return request.auth != null; }
    function soy(uid)    { return conSesion() && request.auth.uid == uid; }
    function esAdmin()   { return conSesion() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function esSocio()   { return conSesion() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan == 'socio'; }
    function texto(v, max) { return v is string && v.size() <= max; }

    // ── Quién es admin ────────────────────────────────────────
    match /admins/{uid} {
      allow get: if soy(uid);      // cada uno solo puede preguntar por sí mismo
      allow list, write: if false; // se gestiona desde la consola de Firebase
    }

    // ── Contenido público ─────────────────────────────────────
    match /ajustes/{id}       { allow read: if true; allow write: if esAdmin(); }
    match /events/{id}        { allow read: if true; allow write: if esAdmin(); }
    match /products/{id}      { allow read: if true; allow write: if esAdmin(); }
    match /collaborators/{id} { allow read: if true; allow write: if esAdmin(); }

    // ── Fichas de usuario ─────────────────────────────────────
    match /users/{uid} {
      allow get: if soy(uid) || esAdmin();
      allow list: if esAdmin();

      // Al crearla: siempre como "miembro" y sin datos de pago.
      allow create: if soy(uid)
        && request.resource.data.keys().hasOnly(['username', 'email', 'plan', 'createdAt', 'telefono', 'vehiculo'])
        && request.resource.data.plan == 'miembro'
        && texto(request.resource.data.username, 60)
        && request.resource.data.email == request.auth.token.email;

      // El usuario solo puede cambiar su nombre, teléfono y vehículo.
      allow update: if soy(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'telefono', 'vehiculo'])
        && texto(request.resource.data.username, 60)
        && texto(request.resource.data.get('telefono', ''), 30)
        && texto(request.resource.data.get('vehiculo', ''), 60);

      // Un admin puede cambiar el plan a mano (regalar o quitar socio).
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan'])
        && request.resource.data.plan in ['miembro', 'socio'];

      allow delete: if false;
    }

    // ── Pedidos (los escribe el servidor tras el pago) ────────
    match /orders/{id} {
      allow read: if esAdmin() || (conSesion() && resource.data.uid == request.auth.uid);
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'seguimiento'])
        && request.resource.data.estado in ['pagado', 'enviado', 'entregado', 'cancelado']
        && texto(request.resource.data.get('seguimiento', ''), 80);
      allow create, delete: if false;
    }

    // ── Inscripciones a eventos ───────────────────────────────
    // El id del documento es siempre  idDelEvento_idDelUsuario
    match /inscripciones/{id} {
      allow read: if esAdmin() || (conSesion() && resource.data.uid == request.auth.uid);

      allow create: if conSesion()
        && request.resource.data.keys().hasOnly(['eventId', 'uid', 'nombre', 'email', 'plan', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventId is string
        && id == request.resource.data.eventId + '_' + request.auth.uid
        && texto(request.resource.data.nombre, 60)
        && request.resource.data.email == request.auth.token.email
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.get('estado', 'abierto') == 'abierto'
        && (get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.get('acceso', 'comunidad') != 'socios' || esSocio());

      allow delete: if esAdmin() || (conSesion() && resource.data.uid == request.auth.uid);
      allow update: if false;
    }

    // ── Mensajes del formulario de contacto ───────────────────
    match /mensajes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nombre', 'email', 'mensaje', 'uid', 'createdAt'])
        && texto(request.resource.data.nombre, 80)
        && texto(request.resource.data.email, 120)
        && texto(request.resource.data.mensaje, 2000)
        && request.resource.data.mensaje.size() >= 10
        && (request.resource.data.uid == null || soy(request.resource.data.uid));
      allow read, delete: if esAdmin();
      allow update: if false;
    }

    // Todo lo demás, cerrado.
    match /{resto=**} { allow read, write: if false; }
  }
}
